#!/usr/bin/env bash
# cld - run Claude Code in named sessions on a private tmux server.
# https://github.com/zadykian/cld
#
# `cld new -n NAME` creates the tmux session "cld-NAME" (NAME defaults to "main") running
# `claude --name cld-NAME` in the current directory and attaches to it; with -w claude also gets
# --worktree NAME, makes git worktree NAME from HEAD or reopens it, and works there.
# `cld join -n NAME` attaches to the session again, `cld kill -n NAME` ends it, and `cld list`
# shows the sessions; all three see only the sessions cld started (see has_session). A private
# server (-L cld, no ~/.tmux.conf) keeps these options away from any other tmux use:
# - extended-keys on: tmux answers no kitty keyboard query, so claude falls back to
#   modifyOtherKeys, which tmux forwards only when this is on (Shift+Enter and friends)
# - the extkeys terminal feature for xterm*: tmux asks the terminal for modified keys only when
#   it knows the terminal supports them, and it does not recognise every terminal that does;
#   Claude Code's docs recommend this for tmux. It goes to a fixed index past tmux's defaults:
#   set -a would add another copy every time cld creates a session
# - mouse on, focus-events on: claude probes both and hints when they are off. With the mouse
#   on, the wheel over a program that draws in the main screen without the mouse - claude
#   outside fullscreen, a shell - scrolls the pane's history; claude's fullscreen transcript
#   gets the wheel either way, as tmux passes claude's own mouse reporting on to the terminal
# - allow-passthrough on: claude wraps its notifications and OSC 52 copies in tmux passthrough
# - status off: claude keeps the whole tab
# - prefix C-q: claude binds C-b (background a task) and nearly every other Ctrl key, but not
#   C-q; detach is C-q d, and C-q C-q sends a C-q through
# - remain-on-exit failed, from tmux 3.5: a claude that fails - at startup, say, for a worktree
#   in a directory it does not trust - leaves its pane on screen with its message, instead of
#   taking both away; /exit and claude's other ways out exit with status 0. An empty
#   remain-on-exit-format keeps tmux from scrolling the pane for its own line, which would push a
#   short error at the top out of sight; the pane-died hook shows how to end the session on the
#   message line instead, until a key is pressed. It names the session through its one window,
#   named NAME: the hook's formats know the pane and its window, not the session. The hook
#   shows it only to a terminal on that window: tmux would show it on another session's
#   terminal, or with none attached keep it and show it in view-mode over the next session a
#   terminal attaches to, which then takes no keys until q; join shows it instead. tmux 3.3 and
#   3.4 keep writing focus reports to a dead pane that had them on, as claude's has, and crash -
#   with every session on the server - when the terminal's focus changes or it detaches, so
#   there remain-on-exit stays off. These go to claude's window only, not the server (see new)
# join attaches with -d, detaching other clients. tmux keeps claude's title changes to the pane
# (set-titles is off), so the tab keeps the session name. The server keeps the environment of
# the client that started it, and claude trusts TERMINAL_EMULATOR over TERM_PROGRAM=tmux: a
# server started from the JetBrains terminal would make every claude on it act as if in
# JediTerm (extended keys off, so Shift+Enter submits) even when attached from iTerm2 - hence
# the env -u.
set -euo pipefail

CLD_VERSION=dev

usage() {
    cat <<'EOF'
usage: cld COMMAND [OPTIONS]

Run Claude Code in named sessions on a private tmux server that ignores ~/.tmux.conf.
Session NAME is the tmux session "cld-NAME", running "claude --name cld-NAME". cld sees
only the sessions it started; tmux -L cld ls lists every session on its server.

commands:
  new [-n NAME] [-w]  create session NAME in the current directory and attach to it
  join [-n NAME]      attach to session NAME, detaching any other terminal from it
  kill [-n NAME]      end session NAME and the claude running in it
  list                list the sessions cld started: name, whether a terminal is
                      attached (or claude exited), and the directory claude is in
  help                show this help
  version             show the version

options:
  -n, --name NAME  the session: letters, digits, "_" and "-", starting with a letter
                   or digit; "main" when not given
  -w, --worktree   new: run claude in git worktree NAME, which claude creates from
                   HEAD or reopens (claude --worktree NAME)

Detach with C-q d; C-q C-q sends C-q to claude. With tmux 3.5 or newer, a session whose
claude fails stays, showing why, until cld kill ends it.
EOF
}

die() {
    printf 'cld: %s\n' "$2" >&2
    exit "$1"
}

# read_options ARGS: a command's options; sets suffix (the session NAME), name and worktree.
read_options() {
    suffix=main
    worktree=false
    while (($#)); do
        case $1 in
        -n | --name)
            (($# > 1)) || die 2 "option '$1' needs a value (see cld help)"
            suffix=$2
            shift
            ;;
        --name=*) suffix=${1#--name=} ;;
        -w | --worktree)
            [[ $command == new ]] || die 2 "$command: unexpected argument '$1' (see cld help)"
            worktree=true
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *) die 2 "$command: unexpected argument '$1' (see cld help)" ;;
        esac
        shift
    done
    # tmux turns "." and ":" into "_" in session names and claude's --name would keep them, so
    # the name is validated instead of silently diverging.
    [[ $suffix =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || die 2 "invalid session name '$suffix' (see cld help)"
    name=cld-$suffix
}

# no_arguments ARGS: for the commands that take none; -h and --help still show the help.
no_arguments() {
    case ${1-} in
    '') ;;
    -h | --help)
        usage
        exit 0
        ;;
    *) die 2 "$command: unexpected argument '$1' (see cld help)" ;;
    esac
}

# has_session: whether session $name exists; a session of that name that cld did not start ends
# cld with an error. new marks the sessions it starts: the user option @cld holds the session's
# id, which $mine checks. Whatever claude runs inherits TMUX, which takes a bare tmux to cld's
# server, and a session made there that way - or by hand with tmux -L cld - is not cld's. The
# mark is the id rather than a flag because a format looks @cld up in the server's, the pane's
# and the window's options before the session's, and a flag set there would mark any session.
# The filter compares whole names, where a target "cld-rev" would find cld-review. No server, no
# session.
mine='#{==:#{@cld},#{session_id}}'
has_session() {
    local filter="#{==:#{session_name},$name}" found
    if ! found=$(tmux -L cld list-sessions -f "$filter" -F "#{?$mine,cld,other}" 2>&1); then
        no_server "$found" || die 1 "$found"
        return 1
    fi
    [[ $found != other ]] ||
        die 1 "session '$suffix' exists, but cld did not start it (see tmux -L cld ls)"
    [[ $found == cld ]]
}

# no_server ERROR: whether tmux failed because cld's server is not running.
no_server() {
    [[ $1 == "no server running on "* || $1 == "error connecting to "* ]]
}

# own_pane: whether this terminal is a live pane of cld's server - claude's external editor, say -
# where a session attached would show inside itself. tmux refuses that too, advising to unset
# $TMUX, but goes by name, dead panes included (see below); cld says how to get out instead, and
# like tmux looks only when $TMUX is set.
own_pane() {
    local terminal panes
    [[ -n ${TMUX-} ]] && terminal=$(tty) &&
        panes=$(tmux -L cld list-panes -a -F '#{?pane_dead,,#{pane_tty}}' 2>/dev/null) &&
        [[ $'\n'$panes$'\n' == *$'\n'"$terminal"$'\n'* ]]
}

command=${1-}
(($# == 0)) || shift
case $command in
new | join | kill) read_options "$@" ;;
list) no_arguments "$@" ;;
help | -h | --help)
    no_arguments "$@"
    usage
    exit 0
    ;;
version | -V | --version)
    no_arguments "$@"
    printf 'cld %s\n' "$CLD_VERSION"
    exit 0
    ;;
'') die 2 "missing command: cld new creates a session, cld join attaches to one (see cld help)" ;;
*)
    # Before cld had commands, "cld NAME" attached to session NAME, creating it first.
    if [[ $command =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]]; then
        die 2 "unknown command '$command'; for session $command: cld new -n $command, cld join -n $command"
    fi
    die 2 "unknown command '$command' (see cld help)"
    ;;
esac

command -v tmux >/dev/null || die 1 "tmux is not installed"
[[ $command != new ]] || command -v claude >/dev/null || die 1 "claude is not installed"
[[ $command != new ]] || ! $worktree || command -v git >/dev/null || die 1 "git is not installed"
# allow-passthrough needs tmux 3.3, keeping failed sessions 3.5 (see above); "tmux next-3.6" and
# "tmux master" are development builds.
tmux_version=$(tmux -V)
version=${tmux_version##* }
version=${version#next-}
remain=failed
if [[ $version =~ ^([0-9]+)\.([0-9]+) ]]; then
    major=${BASH_REMATCH[1]} minor=${BASH_REMATCH[2]}
    ((major > 3 || (major == 3 && minor >= 3))) || die 1 "tmux 3.3 or newer is required, found '$tmux_version'"
    ((major > 3 || (major == 3 && minor >= 5))) || remain=off
fi
# How to end a session whose claude failed, on the message line until a key is pressed (see
# above): the pane-died hook shows it to a terminal attached then, join to one attaching later.
how='#{?pane_dead_signal,signal #{pane_dead_signal},status #{pane_dead_status}}'
hint="display-message -d 0 'claude exited with $how: C-q d detaches, cld kill -n #{window_name} ends the session'"

# tmux refuses to attach a client with $TMUX set whose tty has the name of any pane on the server.
# A dead pane - a failed claude's - keeps the name of its closed pty, and the system hands the name
# to the next terminal opened: inside another tmux, tmux would refuse that terminal as nested. So
# cld makes the check itself, on the live panes, and gives its client an empty TMUX, which tmux's
# check skips; set, even empty, TMUX still tells the client that the terminal takes UTF-8.
if [[ $command == new || $command == join ]]; then
    ! own_pane || die 1 "this terminal is a pane of cld's tmux server; detach with C-q d first"
    [[ -z ${TMUX-} ]] || TMUX=
fi

case $command in
new)
    if has_session; then
        [[ $(tmux -L cld list-panes -t "=$name" -F '#{pane_dead}') != 1 ]] ||
            die 1 "session '$suffix' exists, but its claude exited; end it with cld kill -n $suffix"
        die 1 "session '$suffix' exists; attach to it with cld join -n $suffix"
    fi
    claude=(claude --name "$name")
    if $worktree; then
        # cld reports a missing repository in the terminal; claude would report it in a session
        # left to kill or, with tmux 3.3 and 3.4, in a pane that closes as claude exits.
        [[ $(git rev-parse --is-inside-work-tree 2>/dev/null) == true ]] ||
            die 1 "--worktree needs a git repository, and $PWD is not in one"
        # claude branches a new worktree from the remote's default branch unless worktree.baseRef
        # is "head"; settings given on its command line override the user's and the project's.
        claude+=(--settings '{"worktree":{"baseRef":"head"}}' --worktree "$suffix")
    fi
    printf '\033]0;✳ %s\007' "$name"
    # claude and its arguments go to tmux as separate words: tmux then executes them directly
    # instead of through sh -c. What follows new-session in the same tmux command - the mark,
    # remain-on-exit and the pane-died hook, which go to claude's window only, so that a session
    # made on the server without cld closes as tmux would - takes effect before tmux sees claude
    # exit, however soon; tmux cuts the command short when new-session fails, so a session of
    # that name made meanwhile stays unmarked. The targets end in ":" because set takes a pane,
    # which "=NAME" does not find.
    exec env -u TERMINAL_EMULATOR tmux -L cld -f /dev/null \
        set -s extended-keys on \; set -s 'terminal-features[100]' 'xterm*:extkeys' \; \
        set -s focus-events on \; \
        set -g mouse on \; set -g allow-passthrough on \; set -g status off \; \
        set -g prefix C-q \; bind C-q send-prefix \; \
        new-session -s "$name" -n "$suffix" -c "$PWD" "${claude[@]}" \; \
        set -F -t "=$name:" @cld '#{session_id}' \; \
        set -w -t "=$name:" remain-on-exit "$remain" \; \
        set -w -t "=$name:" remain-on-exit-format '' \; \
        set-hook -w -t "=$name:" pane-died "if -F '#{window_active_clients}' \"$hint\""
    ;;
join)
    has_session || die 1 "no session '$suffix'; create it with cld new -n $suffix"
    printf '\033]0;✳ %s\007' "$name"
    # After attach-session in one command list, the hint goes to this terminal, attached by then.
    exec tmux -L cld attach-session -d -t "=$name" \; if -F '#{pane_dead}' "$hint"
    ;;
kill)
    # claude gets SIGHUP, as when its terminal closes; an attached terminal is detached.
    has_session || die 1 "no session '$suffix' (see cld list)"
    tmux -L cld kill-session -t "=$name"
    ;;
list)
    # pane_current_path is the directory claude is in now, not the one its session started in;
    # once claude has exited there is none, and list shows where the session started. Only the
    # sessions cld started hold their id in @cld (see has_session).
    state_format='#{?pane_dead,exited,#{?session_attached,attached,detached}}'
    path_format='#{?pane_dead,#{session_path},#{pane_current_path}}'
    format="#{session_name}"$'\t'"$state_format"$'\t'"$path_format"
    # tmux writes to a client whose LC_ALL, LC_CTYPE or LANG does not name UTF-8 - unset or C, as
    # over ssh, in containers and cron - with "_" for each character it cannot print: the tabs,
    # and any non-ASCII letter in a directory. -u marks the client UTF-8, so the output arrives
    # as it is.
    if ! sessions=$(tmux -u -L cld list-sessions -f "$mine" -F "$format" 2>&1); then
        no_server "$sessions" || die 1 "$sessions"
        exit 0
    fi
    rows=()
    width=4
    while IFS=$'\t' read -r session state path; do
        [[ $session == cld-* ]] || continue
        session=${session#cld-}
        ((${#session} <= width)) || width=${#session}
        rows+=("$session" "$state" "$path")
    done <<<"$sessions"
    ((${#rows[@]})) || exit 0
    printf '%-*s  %-8s  %s\n' "$width" NAME STATE DIRECTORY
    for ((i = 0; i < ${#rows[@]}; i += 3)); do
        printf '%-*s  %-8s  %s\n' "$width" "${rows[i]}" "${rows[i + 1]}" "${rows[i + 2]}"
    done
    ;;
esac

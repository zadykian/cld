#!/usr/bin/env bash
# Downloads the jars listed in deps.txt into DIR and verifies their checksums.
set -euo pipefail

dir=${1:?usage: fetch-deps DIR}
deps=$(dirname "$0")/deps.txt
mkdir -p "$dir"
grep -v '^#' "$deps" | while read -r sum url; do
    jar=$dir/${url##*/}
    if [[ ! -f $jar ]]; then
        curl -fsSL --retry 3 -o "$jar.tmp" "$url"
        mv "$jar.tmp" "$jar"
    fi
    if command -v sha256sum >/dev/null; then
        echo "$sum  $jar" | sha256sum -c --quiet -
    else
        echo "$sum  $jar" | shasum -a 256 -c --quiet -
    fi
done

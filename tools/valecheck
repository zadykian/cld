#!/bin/sh
# Runs Vale (.vale.ini) on the Markdown files and Go sources that git lists, or on the FILEs:
#
#   tools/valecheck [FILE...]
#
# A Go file goes to Vale as the Markdown mirror of its comments that tools/valemirror writes, and
# its alerts come back with the Go file's lines. Any alert fails the check. Run it from the
# repository's root.

set -eu

# say prints a message of the script's.
say() {
    printf 'tools/valecheck: %s\n' "$*" >&2
}

# die prints a message of the script's and exits with status 1.
die() {
    say "$*"
    exit 1
}

# files writes the files to check to $tmp/files, sorted: the FILEs given, or every one git lists,
# new files included but not those it ignores, as sizecheck takes them. A FILE that is neither
# Markdown nor Go is passed over, so that any list of files will do.
files() {
    if [ $# -eq 0 ]; then
        git ls-files --cached --others --exclude-standard -- '*.md' '*.go' >"$tmp/given"
    else
        for file; do
            [ -f "$file" ] || die "no file $file"
            case $file in
            *.md | *.go) printf '%s\n' "${file#./}" ;;
            esac
        done >"$tmp/given"
    fi
    LC_ALL=C sort -u "$tmp/given" >"$tmp/files"
}

# mirrors writes the mirrors of the Go files into $tmp/mirrors, and lists them in $tmp/mirrored.
mirrors() {
    set --
    while IFS= read -r file; do
        case $file in
        *.go) set -- "$@" "$file" ;;
        esac
    done <"$tmp/files"
    : >"$tmp/mirrored"
    [ $# -gt 0 ] || return 0
    go build -o "$tmp/valemirror" ./tools/valemirror || die "cannot build tools/valemirror"
    "$tmp/valemirror" "$tmp/mirrors" "$@" >"$tmp/mirrored" || die "tools/valemirror failed"
}

# alerts writes Vale's alerts to $tmp/alerts, a line each.
alerts() {
    mirrors
    set --
    while IFS= read -r file; do
        case $file in
        *.md) set -- "$@" "$file" ;;
        esac
    done <"$tmp/files"
    while IFS= read -r file; do
        set -- "$@" "$file"
    done <"$tmp/mirrored"
    # Vale reads stdin when given no file.
    if [ $# -gt 0 ]; then
        tools/run vale --no-exit --output=line "$@" >"$tmp/vale" || die "Vale failed"
    else
        : >"$tmp/vale"
    fi
    if [ -s "$tmp/mirrored" ]; then
        "$tmp/valemirror" -alerts "$tmp/mirrors" <"$tmp/vale" >"$tmp/alerts" ||
            die "tools/valemirror failed"
    else
        cp "$tmp/vale" "$tmp/alerts"
    fi
}

main() {
    [ -f .vale.ini ] || die "run it from the repository's root"
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    trap 'exit 1' HUP INT TERM

    files "$@"
    alerts
    [ -s "$tmp/alerts" ] || return 0
    cat "$tmp/alerts"
    return 1
}

main "$@"

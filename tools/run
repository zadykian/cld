#!/bin/sh
# Runs one of the lint tools `make lint` uses, at the version pinned here:
#
#   tools/run NAME [ARG...]   runs the tool with the ARGs
#   tools/run -path NAME      prints the path of the tool's executable
#
# Each tool comes from its GitHub release for Linux or macOS on amd64 or arm64. The first run
# downloads it into .cache/tools and checks its SHA-256. A bump changes a tool's version and its
# four sums, which the release's checksums file or GitHub's asset digests give. It needs curl,
# tar, and sha256sum or shasum.
#
# libghostty-vt is no program but the C headers that golangci-lint and govulncheck type-check the
# ghostty driver against, at the commit tests/ghostty/deps.txt pins, fetched with git. -path
# prints the pkg-config directory that names them, and tools/run golangci-lint adds it to
# PKG_CONFIG_PATH.

set -eu

# say prints a message of the script's.
say() {
    printf 'tools/run: %s\n' "$*" >&2
}

# die prints a message of the script's and exits with status 1.
die() {
    say "$*"
    exit 1
}

# platform sets os and arch as Go names them, and cpu as Rust and ShellCheck name arch.
platform() {
    case $(uname -s) in
    Linux) os=linux ;;
    Darwin) os=darwin ;;
    *) die "the tools are pinned for Linux and macOS, not $(uname -s)" ;;
    esac
    case $(uname -m) in
    x86_64 | amd64) arch=amd64 cpu=x86_64 ;;
    aarch64 | arm64) arch=arm64 cpu=aarch64 ;;
    *) die "the tools are pinned for x86_64 and arm64, not $(uname -m)" ;;
    esac
}

# pick sets sum to the one of the four SHA-256 sums, in the order linux-amd64, linux-arm64,
# darwin-amd64 and darwin-arm64, that is this platform's.
pick() {
    case $os-$arch in
    linux-amd64) sum=$1 ;;
    linux-arm64) sum=$2 ;;
    darwin-amd64) sum=$3 ;;
    darwin-arm64) sum=$4 ;;
    esac
}

# pin sets version, url, sum and member for the tool $1. member is the executable's path in the
# archive, or empty where the download is the executable itself.
pin() {
    gh=https://github.com
    case $1 in
    actionlint)
        version=1.7.12
        url=$gh/rhysd/actionlint/releases/download/v$version
        url=$url/actionlint_${version}_${os}_$arch.tar.gz
        member=actionlint
        pick 8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8 \
            325e971b6ba9bfa504672e29be93c24981eeb1c07576d730e9f7c8805afff0c6 \
            5b44c3bc2255115c9b69e30efc0fecdf498fdb63c5d58e17084fd5f16324c644 \
            aba9ced2dee8d27fecca3dc7feb1a7f9a52caefa1eb46f3271ea66b6e0e6953f
        ;;
    golangci-lint)
        version=2.14.0
        member=golangci-lint-$version-$os-$arch
        url=$gh/golangci/golangci-lint/releases/download/v$version/$member.tar.gz
        member=$member/golangci-lint
        pick ab90aeb7b066f92a33415b638a50fe5344bbb75a0d32ad30cc248d88f81032ab \
            ee7ec5f3453d15ddf106fae5a4d6c71737712348a979d1fe9cd52ec7ea299bae \
            a5667c1c3536be1740133213e1e822bfb8f0d98ea12903174d6d5f635e4ed68d \
            5ef5f36a7147e91dc58ef9ef4d11bb7bad5ead0c76eb6c01327a73c641d1dcc3
        ;;
    lychee)
        # Linux's build is musl's, which links statically.
        version=0.24.2
        case $os in
        linux) member=lychee-$cpu-unknown-linux-musl ;;
        darwin) member=lychee-$cpu-apple-darwin ;;
        esac
        url=$gh/lycheeverse/lychee/releases/download/lychee-v$version/$member.tar.gz
        member=$member/lychee
        pick 73657a111819a30c47c08352896796f23d64e4eb2b3ed39b6d32149241566fc5 \
            5d0b0e3aeab240f41920c633a6eaf97599be6eedda034b36e858ede7dba5e535 \
            887503a9cff667d322b8d0892b40bf49976eb9507af8483220a3706cdad55978 \
            c9d3740ea2d891854d37116c9fba840f37b6e7c89d330e7db84ac333631c4977
        ;;
    shellcheck)
        version=0.11.0
        url=$gh/koalaman/shellcheck/releases/download/v$version
        url=$url/shellcheck-v$version.$os.$cpu.tar.gz
        member=shellcheck-v$version/shellcheck
        pick b7af85e41cc99489dcc21d66c6d5f3685138f06d34651e6d34b42ec6d54fe6f6 \
            68a8133197a50beb8803f8d42f9908d1af1c5540d4bb05fdfca8c1fa47decefc \
            c2c15e08df0e8fbc374c335b230a7ee958c313fa5714817a59aa59f1aa594f51 \
            339b930feb1ea764467013cc1f72d09cd6b869ebf1013296ba9055ab2ffbd26f
        ;;
    shfmt)
        version=3.14.1
        url=$gh/mvdan/sh/releases/download/v$version/shfmt_v${version}_${os}_$arch
        member=
        pick 76e77641faa025814b77f153b29796b8e6fa2fca03e0c76a691608b86c7ea7bf \
            5f2db09dae91fca848f7adbdd014632e921a383863a2ad7e0450ad3aba0c6489 \
            d33eee0da0f92835b3562e9767a05cee7e4eaeef47daa03bfd09da17b4b590a6 \
            b7c872db63553ccffc7253aba3ed7d4885a27d83f1ba567b1138c6315a5847e5
        ;;
    vale)
        # Vale's release binaries, as it needs cgo to read code comments.
        version=3.23.0
        case $os-$arch in
        linux-amd64) member=Linux_64-bit ;;
        linux-arm64) member=Linux_arm64 ;;
        darwin-amd64) member=macOS_64-bit ;;
        darwin-arm64) member=macOS_arm64 ;;
        esac
        url=$gh/errata-ai/vale/releases/download/v$version/vale_${version}_$member.tar.gz
        member=vale
        pick cc35445a45186b8f0b01e11c01359694cf941e72cf6ab0fc44774f0e54c9d5fc \
            45720aadcb01401ac394641287a2c74e094045a89a450f5edcf98c8969df0884 \
            416fdd3ba32e32dc71c87b479cb86757bb6437bcebc7a3e4a095e863b7ce583d \
            b913574b2c83b541d8bc2d8938e53a58a2fb06bab15135efcc755afb074f4430
        ;;
    zizmor)
        version=1.30.1
        case $os in
        linux) member=$cpu-unknown-linux-gnu ;;
        darwin) member=$cpu-apple-darwin ;;
        esac
        url=$gh/zizmorcore/zizmor/releases/download/v$version/zizmor-$member.tar.gz
        member=zizmor
        pick e65324f4430c2717591937edcec90ccbefaf14c174f8ec9415e03ca875b46e1a \
            7ff1dce33bdd18fd2a4affe63bdd47efcccca97b2cec1c1863ec26e9e2647540 \
            10e6b18b11ea07e515a16f0f0518c7b07527bc9977c1fd5698181ce7f3554202 \
            e28d22b087f9ebb8d99da6e740d348c930f559961c7c3f12badda54f882195a2
        ;;
    libghostty-vt)
        # No program: libghostty-vt's C headers at the Ghostty commit that tests/ghostty/deps.txt
        # pins for the ghostty driver (docs/design/decisions/0054-ghostty.md), fetched with git.
        line=$(grep -F /ghostty-org/ghostty "$root/tests/ghostty/deps.txt") ||
            die "tests/ghostty/deps.txt pins no Ghostty commit"
        version=${line%% *}
        url=${line##* }
        sum=
        member=include
        ;;
    *)
        die "no tool $1: actionlint, golangci-lint, libghostty-vt, lychee, shellcheck, shfmt," \
            "vale or zizmor"
        ;;
    esac
}

# headers prints the directory of libghostty-vt-static.pc, which names libghostty-vt's headers
# alone, relative to itself, so that a .cache/tools shared between checkouts keeps working. It
# writes the file at each run, whole, as an older one named them by an absolute path.
headers() {
    pc=${bin%/*}/libghostty-vt-static.pc
    # shellcheck disable=SC2016 # pkg-config, not the shell, expands ${pcfiledir}
    printf '%s\n' 'Name: libghostty-vt-static' "Description: libghostty-vt's headers alone" \
        'Version: 0' 'Cflags: -I${pcfiledir}/libghostty-vt' 'Libs:' >"$pc.$$"
    mv -f "$pc.$$" "$pc"
    printf '%s\n' "${bin%/*}"
}

# checkout fetches the directory $member of the repository $url at the commit $version, checking
# the commit it got: blobs outside $member stay unfetched. $bin then links to it, a link made whole
# or not at all, so that a second run at once keeps the first's.
checkout() {
    command -v git >/dev/null || die "libghostty-vt's headers need git"
    # Under git rebase --exec in a linked worktree, GIT_DIR would have git init turn that
    # worktree's git directory bare (docs/design/findings/environment.md), and a hook's
    # GIT_INDEX_FILE would take the checkout elsewhere: git's own variables go.
    for variable in $(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p'); do
        unset "$variable"
    done
    mkdir -p "${bin%/*}"
    tmp=$(mktemp -d "${bin%/*}/$member.XXXXXX")
    trap 'rm -rf "$tmp"' EXIT
    trap 'exit 1' HUP INT TERM
    say "fetching $1 $version"
    git -C "$tmp" init -q
    git -C "$tmp" remote add origin "$url"
    git -C "$tmp" fetch -q --depth=1 --filter=blob:none origin "$version" ||
        die "cannot fetch $version from $url"
    got=$(git -C "$tmp" rev-parse FETCH_HEAD)
    [ "$got" = "$version" ] || die "$url gave $got, not $version"
    git -C "$tmp" checkout -q FETCH_HEAD -- "$member"
    rm -rf "$tmp/.git"
    chmod 755 "$tmp"
    # -n: a link that another run made first is no directory to put this one in.
    if ln -sn "${tmp##*/}/$member" "$bin" 2>/dev/null; then
        trap - EXIT HUP INT TERM
    else
        [ -d "$bin" ] || die "$bin is broken: remove it"
        rm -rf "$tmp"
        trap - EXIT HUP INT TERM
    fi
}

# sha256 prints the SHA-256 checksum of the file $1.
sha256() {
    if command -v sha256sum >/dev/null; then
        sha256sum <"$1"
    else
        shasum -a 256 <"$1"
    fi | awk '{ print $1 }'
}

# fetch downloads the tool $1 to $bin, checked against its sum. The executable moves into place
# last, so that a download cut short or a second run at once leaves no partial file there.
fetch() {
    mkdir -p "$cache"
    tmp=$(mktemp -d "$cache/.fetch.XXXXXX")
    trap 'rm -rf "$tmp"' EXIT
    trap 'exit 1' HUP INT TERM
    say "downloading $1 $version"
    curl -fsSL --retry 3 --proto-redir =https -o "$tmp/download" "$url" ||
        die "cannot download $url"
    [ "$(sha256 "$tmp/download")" = "$sum" ] ||
        die "$url does not match the SHA-256 pinned in tools/run"
    if [ -n "$member" ]; then
        tar -xzf "$tmp/download" -C "$tmp" "$member" || die "$url has no $member"
        rm "$tmp/download"
        mv "$tmp/$member" "$tmp/download"
    fi
    chmod 755 "$tmp/download"
    mkdir -p "${bin%/*}"
    mv -f "$tmp/download" "$bin"
    rm -rf "$tmp"
    trap - EXIT HUP INT TERM
}

main() {
    path=false
    if [ "${1-}" = -path ]; then
        path=true
        shift
    fi
    [ $# -ge 1 ] || die "usage: tools/run NAME [ARG...] or tools/run -path NAME"
    name=$1
    shift
    platform
    root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
    pin "$name"
    cache=$root/.cache/tools
    bin=$cache/$name-$version/$name
    if [ ! -x "$bin" ]; then
        if [ -n "$sum" ]; then fetch "$name"; else checkout "$name"; fi
    fi
    if [ "$name" = libghostty-vt ]; then
        $path || die "libghostty-vt is headers: tools/run -path libghostty-vt"
        headers
    elif $path; then
        printf '%s\n' "$bin"
    else
        if [ "$name" = golangci-lint ]; then
            pc=$("$0" -path libghostty-vt) || die "no libghostty-vt headers for golangci-lint"
            PKG_CONFIG_PATH=$pc${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}
            export PKG_CONFIG_PATH
        fi
        exec "$bin" "$@"
    fi
}

main "$@"
